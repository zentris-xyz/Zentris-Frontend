# Backend
VITE_API_URL=http://localhost:4000

# Supra network
VITE_SUPRA_CHAIN_ID=6
VITE_SUPRA_RPC=https://rpc-testnet.supra.com

# Zentris Move module address — WAJIB diisi setelah deploy kontrak
# Placeholder di bawah akan membuat vault dan strategy gagal
VITE_ZENTRIS_MODULE_ADDRESS=0xabc...

# Coin types
VITE_USDC_COIN_TYPE=0xe5ae87f5c4bbe2c324bba7c498e32aae3f314a455b5caa84677e1160a29e8fdc::coins::USDC

# Oracle REST pair (fallback harga, CoinGecko utama)
VITE_SUPRA_PRICE_PAIR=supra_usdt

# Debug logging untuk [supra] di console
VITE_DEBUG_SUPRA=true
